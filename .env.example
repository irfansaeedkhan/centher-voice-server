# Copy to ~/.centher-voice.env on the VM and fill in real values.
# NEVER commit the filled-in file.

# Port the server listens on (Caddy proxies 443 -> this).
PORT=3001

# Comma-separated origins allowed to open a socket. The web app's origin
# MUST be listed or browsers get "origin not allowed".
ALLOWED_ORIGINS=https://centher-app.vercel.app,http://localhost:3000

# Shared secret for voice JWT verification. MUST be IDENTICAL to the web
# app's BETTER_AUTH_SECRET (the app mints the tokens with it).
# Copy the value from the app's Vercel env vars — never commit it.
AUTH_JWT_SECRET=put-the-apps-BETTER_AUTH_SECRET-here

# Public IP (or hostname) of THIS machine — baked into ICE candidates so
# browsers can reach the UDP media ports. Use the VM's public IPv4.
MEDIASOUP_ANNOUNCED_IP=0.0.0.0

# UDP port range mediasoup uses for audio/video. Must be open in the
# cloud firewall AND the OS firewall.
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999

# Workers are capped at 4 by default; override only on bigger machines.
# MEDIASOUP_NUM_WORKERS=4
