{"dependencies":{"dotenv":"^16.4.5","jose":"^6.2.12","mediasoup":"^3.15.0","socket.io":"^4.7.5","uuid":"^9.0.1"},"description":"Socket.io + mediasoup SFU voice server for Centher VoiSpace rooms","devDependencies":{"@types/node":"^20.12.0","@types/uuid":"^9.0.8","prettier":"^3.2.5","ts-node":"^10.9.2","typescript":"^5.4.0","vitest":"^1.5.0"},"engines":{"node":">=20 <23"},"license":"UNLICENSED","main":"dist/index.js","name":"centher-voice-server","private":true,"scripts":{"build":"tsc -p tsconfig.json","dev":"ts-node --transpile-only src/index.ts","format":"prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"","format:check":"prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"","start":"node dist/index.js","test":"vitest run","test:watch":"vitest","typecheck":"tsc --noEmit"},"type":"commonjs","version":"0.1.0"}